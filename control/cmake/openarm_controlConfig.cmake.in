@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(openarm_model CONFIG)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/openarm_controlTargets.cmake")
if(NOT TARGET OpenArm::Control)
  add_library(OpenArm::Control INTERFACE IMPORTED)
  set_property(TARGET OpenArm::Control PROPERTY
    INTERFACE_LINK_LIBRARIES openarm_control::openarm_control)
endif()
check_required_components(openarm_control)
