@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/openarm_modelTargets.cmake")
if(NOT TARGET OpenArm::Model)
  add_library(OpenArm::Model INTERFACE IMPORTED)
  set_property(TARGET OpenArm::Model PROPERTY
    INTERFACE_LINK_LIBRARIES openarm_model::openarm_model)
endif()
set(openarm_model_GENERATED_URDF
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/openarm_model/openarm_v10_bimanual.urdf")
check_required_components(openarm_model)
