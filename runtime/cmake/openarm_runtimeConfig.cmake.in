@PACKAGE_INIT@

set_and_check(openarm_runtime_V1_INCLUDE_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/openarm_runtime_abi_v1")
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(openarm_model 1 CONFIG)
find_dependency(openarm_commission 0.1.0 EXACT CONFIG)
find_dependency(openarm_control 1 CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/openarm_runtimeTargets.cmake")
check_required_components(openarm_runtime)
