<?xml version="1.0"?>
<!--
  Real-hardware counterpart to openarm_ik_rviz.launch.xml.

  The same action-server executable is selected with physical_hardware=true.
  Its real session starts passive, publishes no simulated state, and cannot
  energise a motor until the portal's Connect service is explicitly called.

  robot_state_publisher is shared with the virtual launch and is still the sole
  TF authority.
-->
<launch>
  <arg name="rviz" default="true"/>
  <!-- This installed pair was confirmed by physical motion under the passive
       observer: can0 is robot-right and can1 is robot-left. -->
  <arg name="interface_a" default="can0"/>
  <arg name="interface_b" default="can1"/>
  <!-- Bit 0 selects robot-left and bit 1 robot-right. -->
  <arg name="active_side_mask" default="3"/>
  <!-- Construction is passive. Only the portal's Connect button enables the
       motors, after fresh encoder feedback seeds every hold target. -->

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" output="screen">
    <!-- The full URDF, not the Stage-A visualization one. Stage-A deliberately
         welds the finger joints to fixed because the virtual stack has no
         gripper control, and a fixed joint cannot move no matter what is
         published, so the claws would never open on screen. The full model
         keeps them prismatic. -->
    <param name="robot_description" type="str"
           value="$(command 'cat $(find-pkg-share openarm_ik_ros)/urdf/openarm_v10_bimanual.urdf')"/>
  </node>

  <node pkg="openarm_ik_ros" exec="openarm_ik_ros_node"
        name="openarm_real_controller" output="screen">
    <param name="physical_hardware" value="true"/>
    <param name="right_can_interface" value="$(var interface_a)"/>
    <param name="left_can_interface" value="$(var interface_b)"/>
    <param name="active_side_mask" value="$(var active_side_mask)"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        if="$(var rviz)"
        args="-d $(find-pkg-share openarm_ik_ros)/rviz/openarm_ik.rviz"/>
</launch>
