<?xml version="1.0"?>
<package format="3">
  <name>openarm_ik_ros</name>
  <version>0.1.0</version>
  <description>Hardware-free paired position-IK visualization adapter for the OpenArm v1.0 model.</description>
  <maintainer email="maintainers@example.invalid">OpenArmIK maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>openarm_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>python3</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
