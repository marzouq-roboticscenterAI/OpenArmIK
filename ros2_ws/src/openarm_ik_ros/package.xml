<?xml version="1.0"?>
<package format="3">
  <name>openarm_ik_ros</name>
  <version>0.2.0</version>
  <description>Measured-feedback ROS 2 adapter for the OpenArm Stage-A virtual controller.</description>
  <maintainer email="maintainers@example.invalid">OpenArmIK maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>libx11-dev</depend>
  <depend>libxcomposite-dev</depend>
  <depend>libjpeg-dev</depend>
  <depend>libboost-dev</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>openarm_control_msgs</depend>
  <depend>openarm_model</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>openarm_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>python3</test_depend>
  <test_depend>rclpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
